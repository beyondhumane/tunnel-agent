<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TunnelAgent.ViewModels"
             xmlns:cv="using:TunnelAgent.Converters"
             xmlns:ctrl="using:TunnelAgent.Controls"
             xmlns:lucide="using:IconPacks.Avalonia.Lucide"
             xmlns:l="using:TunnelAgent.Services"
             x:Class="TunnelAgent.Views.QuotaView"
             x:Name="Root"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Resources>
        <cv:StringNotEmptyConverter x:Key="StringNotEmpty" />
        <cv:InvertBoolConverter     x:Key="InvertBool" />
    </UserControl.Resources>

    <StackPanel Spacing="0" Margin="0,0,0,24">
        <StackPanel Spacing="0" IsVisible="{Binding IsQuotaLimitsSelected}">
        <ctrl:SlidingTabBar Margin="0,0,0,16"
                            SelectedIndex="{Binding QuotaTabIndex}">
            <ctrl:SlidingTabBar.Tabs>
                <ctrl:SlidingTab Header="Claude" HasIcon="True" IconKind="Claude"
                                 Command="{Binding SelectQuotaProviderByIdCommand}" CommandParameter="claude" />
                <ctrl:SlidingTab Header="Codex" HasIcon="True" IconKind="OpenAi"
                                 Command="{Binding SelectQuotaProviderByIdCommand}" CommandParameter="codex" />
                <ctrl:SlidingTab Header="Devin" HasIcon="True"
                                 CustomIconData="M2.033 9.867l2.554 1.483a.589.589 0 00.592 0l2.554-1.483.01-.008a.608.608 0 00.11-.084l.013-.015a.631.631 0 00.076-.1c.003-.005.008-.01.01-.016a.558.558 0 00.052-.125l.007-.028a.611.611 0 00.019-.14V7.868c0-.572.307-1.105.8-1.392a1.595 1.595 0 011.598 0l1.277.742a.54.54 0 00.129.053l.028.01c.044.01.088.015.133.016h.006l.013-.002a.587.587 0 00.27-.074l.011-.004 2.554-1.483a.596.596 0 00.297-.516V2.253a.595.595 0 00-.297-.516L12.293.257a.587.587 0 00-.591 0L9.148 1.737l-.01.01a.609.609 0 00-.109.083l-.014.015a.632.632 0 00-.076.1c-.003.005-.008.01-.01.016a.57.57 0 00-.052.124l-.007.028a.612.612 0 00-.018.14v1.483c0 .572-.307 1.105-.8 1.393a1.597 1.597 0 01-1.599 0l-1.276-.742a.603.603 0 00-.13-.053l-.028-.008a.658.658 0 00-.133-.018h-.02a.57.57 0 00-.269.074c-.003.002-.008.002-.012.005L2.033 5.872a.596.596 0 00-.297.515v2.966c0 .213.113.41.297.515zM15.943 10.607a1.596 1.596 0 011.599 0l1.276.74c.041.025.085.04.13.055l.028.008c.043.01.088.016.133.018h.005c.005 0 .01-.002.014-.003a.474.474 0 00.122-.016l.021-.005a.616.616 0 00.126-.052c.004-.002.009-.002.013-.005l2.554-1.482a.597.597 0 00.297-.516V6.383a.596.596 0 00-.297-.515l-2.552-1.483a.587.587 0 00-.592 0l-2.553 1.482-.011.008a.61.61 0 00-.108.084l-.014.016a.637.637 0 00-.076.1c-.003.005-.008.01-.01.016a.57.57 0 00-.052.124l-.007.029a.612.612 0 00-.018.14v1.482c0 .572-.307 1.105-.8 1.393a1.597 1.597 0 01-1.599 0l-1.276-.742a.584.584 0 00-.13-.053l-.028-.008a.62.62 0 00-.133-.018h-.02a.587.587 0 00-.269.074l-.012.004L9.15 10a.596.596 0 00-.296.516v2.966c0 .212.112.409.296.515l2.554 1.483s.008.002.012.005c.04.022.082.04.126.052l.02.004a.57.57 0 00.123.017l.014.002h.006c.054 0 .108-.01.16-.025a.587.587 0 00.13-.054l1.277-.741a1.597 1.597 0 012.398 1.392v1.482c0 .049.007.095.019.14l.007.028a.619.619 0 00.051.125c.004.006.008.01.01.016a.6.6 0 00.076.1l.014.015c.033.032.069.06.108.084.004.002.006.006.011.008l2.554 1.483a.59.59 0 00.593 0l2.554-1.483a.597.597 0 00.296-.516v-2.965a.595.595 0 00-.296-.516l-2.554-1.483s-.008-.002-.012-.005a.54.54 0 00-.126-.051c-.007-.003-.013-.003-.02-.005a.635.635 0 00-.125-.017h-.018a.557.557 0 00-.16.026.588.588 0 00-.13.053l-1.276.742a1.595 1.595 0 01-1.598 0 1.615 1.615 0 010-2.785l-.005-.001zM14.848 18.265l-2.554-1.482-.012-.005a.526.526 0 00-.126-.052c-.007-.002-.014-.002-.02-.005a.64.64 0 00-.124-.017h-.02a.56.56 0 00-.16.026.588.588 0 00-.13.053l-1.276.742a1.594 1.594 0 01-1.598 0c-.493-.286-.8-.82-.8-1.393V14.65a.563.563 0 00-.018-.14l-.008-.028a.604.604 0 00-.051-.124l-.01-.017a.603.603 0 00-.076-.1l-.014-.015a.596.596 0 00-.109-.084c-.003-.002-.005-.006-.01-.008L5.178 12.65a.587.587 0 00-.591 0l-2.554 1.483a.596.596 0 00-.297.516v2.965c0 .213.113.41.297.516l2.554 1.483.012.004a.618.618 0 00.267.074l.016.002h.007a.55.55 0 00.16-.026.584.584 0 00.129-.053l1.277-.742a1.597 1.597 0 012.398 1.393v1.482c0 .05.007.095.019.14l.007.028c.013.044.03.085.051.125l.01.016c.022.036.047.07.076.1l.014.015c.032.032.069.06.109.084l.01.008 2.554 1.483a.587.587 0 00.593 0l2.554-1.483a.596.596 0 00.296-.515v-2.966a.596.596 0 00-.296-.516h-.002z"
                                 Command="{Binding SelectQuotaProviderByIdCommand}" CommandParameter="devin" />
                <ctrl:SlidingTab Header="Antigravity" HasIcon="True"
                                 CustomIconData="M21.751 22.607c1.34 1.005 3.35.335 1.508-1.508C17.73 15.74 18.904 1 12.037 1 5.17 1 6.342 15.74.815 21.1c-2.01 2.009.167 2.511 1.507 1.506 5.192-3.517 4.857-9.714 9.715-9.714 4.857 0 4.522 6.197 9.714 9.715z"
                                 Command="{Binding SelectQuotaProviderByIdCommand}" CommandParameter="antigravity" />
                <ctrl:SlidingTab Header="xAI" HasIcon="True"
                                 CustomIconData="M6.469 8.776L16.512 23h-4.464L2.005 8.776H6.47zM6.465 16.676l2.233 3.164L6.467 23H2l4.465-6.324zM22 2.582V23h-3.659V7.764L22 2.582zM22 1l-9.952 14.095-2.233-3.163L17.533 1H22z"
                                 Command="{Binding SelectQuotaProviderByIdCommand}" CommandParameter="xai" />
                <ctrl:SlidingTab Header="Cursor" HasIcon="True"
                                 CustomIconData="M22.106 5.68L12.5.135a.998.998 0 00-.998 0L1.893 5.68a.84.84 0 00-.419.726v11.186c0 .3.16.577.42.727l9.607 5.547a.999.999 0 00.998 0l9.608-5.547a.84.84 0 00.42-.727V6.407a.84.84 0 00-.42-.726zm-.603 1.176L12.228 22.92c-.063.108-.228.064-.228-.061V12.34a.59.59 0 00-.295-.51l-9.11-5.26c-.107-.062-.063-.228.062-.228h18.55c.264 0 .428.286.296.514z"
                                 Command="{Binding SelectQuotaProviderByIdCommand}" CommandParameter="cursor" />
                <ctrl:SlidingTab Header="Kiro" HasIcon="True"
                                 CustomIconData="M7.97 16.376c-1.644 3.642 1.86 4.556 4.443 2.424.76 2.39 3.608.607 4.631-1.247 2.251-4.084 1.342-8.249 1.108-9.108-1.6-5.859-9.6-5.869-10.976.03-.323 1.033-.328 2.206-.507 3.423-.09.617-.16 1.009-.393 1.655-.139.373-.323.7-.62 1.257-.458.865-.264 2.53 2.101 1.665l.224-.1h-.01l-.001.001z"
                                 Command="{Binding SelectQuotaProviderByIdCommand}" CommandParameter="kiro" />
                <ctrl:SlidingTab Header="Trae" HasIcon="True"
                                 CustomIconData="M24 20.541H3.428v-3.426H0V3.4h24V20.54zM3.428 17.115h17.144V6.827H3.428v10.288zm8.573-5.196l-2.425 2.424-2.424-2.424 2.424-2.424 2.425 2.424zm6.857-.001l-2.424 2.423-2.425-2.423 2.425-2.425 2.424 2.425z"
                                 Command="{Binding SelectQuotaProviderByIdCommand}" CommandParameter="trae" />
            </ctrl:SlidingTabBar.Tabs>
        </ctrl:SlidingTabBar>

        <Grid Margin="0,0,0,16" ColumnDefinitions="*,Auto">
            <StackPanel>
                <TextBlock Classes="page-title" Text="{l:Loc QuotaView_Title}" />
                <TextBlock Classes="page-sub" Text="{l:Loc QuotaView_Subtitle}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="icon"
                    ToolTip.Tip="{l:Loc QuotaView_RefreshAllTooltip}"
                    VerticalAlignment="Bottom"
                    IsEnabled="{Binding HasQuotaAccounts}"
                    Click="OnRefreshAllQuota">
                <lucide:PackIconLucide Kind="RefreshCw"
                                       Width="14"
                                       Height="14"
                                       Classes.spin="{Binding IsRefreshingAllQuotaProviders}" />
            </Button>
        </Grid>

        <Border Classes="card"
                Padding="22"
                IsVisible="{Binding HasQuotaProviders, Converter={StaticResource InvertBool}}">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <lucide:PackIconLucide Kind="ChartBar"
                                       Width="30"
                                       Height="30"
                                       Foreground="{DynamicResource FgFaintBrush}"
                                       HorizontalAlignment="Center" />
                <TextBlock Classes="row-label" Text="{l:Loc QuotaView_NoProviders_Title}" HorizontalAlignment="Center" />
                <TextBlock Classes="row-desc"
                           Text="{Binding QuotaEmptyStateText}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="420" />
            </StackPanel>
        </Border>

        <Border Classes="card"
                Padding="22"
                IsVisible="{Binding ShowQuotaAccountEmptyState}">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <lucide:PackIconLucide Kind="UserRoundX"
                                       Width="30"
                                       Height="30"
                                       Foreground="{DynamicResource FgFaintBrush}"
                                       HorizontalAlignment="Center" />
                <TextBlock Classes="row-label" Text="{l:Loc QuotaView_NoAccounts_Title}" HorizontalAlignment="Center" />
                <TextBlock Classes="row-desc"
                           Text="{Binding QuotaEmptyStateText}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="420" />
            </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding SelectedQuotaAccounts}"
                      IsVisible="{Binding HasSelectedQuotaAccounts}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProviderAccountViewModel">
                    <Border Classes="card" Padding="16" Margin="0,0,0,14">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <StackPanel Grid.Column="0"
                                            Grid.RowSpan="2"
                                            Orientation="Horizontal"
                                            Spacing="10"
                                            VerticalAlignment="Center">
                                    <Border Classes="chip"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            IsVisible="{Binding PlanBadge, Converter={StaticResource StringNotEmpty}}">
                                        <TextBlock Text="{Binding PlanBadge}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontWeight="Bold" />
                                    </Border>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource FgBrush}" />
                                        <TextBlock Text="{Binding MaskedKey}"
                                                   FontFamily="Cascadia Mono,Consolas,monospace"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource FgMutedBrush}"
                                                   IsVisible="{Binding IsCustomKey}" />
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Grid.Row="0"
                                        Classes="icon"
                                        ToolTip.Tip="{l:Loc QuotaView_Account_RefreshTooltip}"
                                        Click="OnRefreshQuota"
                                        Tag="{Binding}">
                                    <lucide:PackIconLucide Kind="RefreshCw"
                                                           Width="14"
                                                           Height="14"
                                                           Classes.spin="{Binding IsRefreshing}" />
                                </Button>
                                <Border Grid.Column="1"
                                        Grid.Row="1"
                                        Classes="chip"
                                        Background="#14000000"
                                        HorizontalAlignment="Right"
                                        Margin="0,6,0,0"
                                        IsVisible="False">
                                    <TextBlock Text="disabled" Foreground="{DynamicResource FgMutedBrush}" />
                                </Border>
                            </Grid>

                            <StackPanel Spacing="10" IsVisible="{Binding HasQuota}">
                                <TextBlock Classes="section-label" Text="{l:Loc QuotaView_Account_UsageSection}" Margin="0" />
                                <ItemsControl ItemsSource="{Binding QuotaBars}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:QuotaBarViewModel">
                                            <StackPanel Spacing="5" Margin="0,0,0,10">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Title}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource FgBrush}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding UsedLabel}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                </Grid>
                                                <ProgressBar Minimum="0"
                                                             Maximum="1"
                                                             Value="{Binding Used}"
                                                             Height="9"
                                                             IsVisible="{Binding HasProgress}" />
                                                <TextBlock Text="{Binding ResetIn}"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource FgFaintBrush}"
                                                           IsVisible="{Binding ResetIn, Converter={StaticResource StringNotEmpty}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding QuotaNoticeText}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource WarnBrush}"
                                           IsVisible="{Binding HasQuotaNotice}" />
                            </StackPanel>

                            <Border Background="#08FFFFFF"
                                    CornerRadius="8"
                                    Padding="14"
                                    IsVisible="{Binding HasQuota, Converter={StaticResource InvertBool}}">
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="row-label" Text="{Binding QuotaEmptyLabel}" />
                                    <TextBlock Classes="row-desc" Text="{Binding QuotaEmptyDescription}" />
                                </StackPanel>
                            </Border>

                            <Border Background="#08FFFFFF"
                                    CornerRadius="8"
                                    IsVisible="{Binding HasResetCredits}">
                                <StackPanel>
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,10" ColumnSpacing="8">
                                        <ToggleButton Grid.Column="0" Classes="chevron" Width="22" Height="22" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsResetSectionExpanded, Mode=TwoWay}">
                                            <lucide:PackIconLucide Kind="ChevronRight" Width="14" Height="14"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource FgBrush}" />
                                        </ToggleButton>
                                        <TextBlock Grid.Column="1" Classes="row-label" VerticalAlignment="Center"
                                                   Text="{l:Loc QuotaView_Reset_SectionTitle}" />
                                        <Border Grid.Column="2" CornerRadius="999" Background="#1850C878" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ResetCountBadge}" FontSize="11" FontWeight="SemiBold" Foreground="#50C878" />
                                        </Border>
                                    </Grid>

                                    <Border Classes="collapsible" Classes.expanded="{Binding IsResetSectionExpanded}">
                                        <StackPanel Margin="12,0,12,10" Spacing="10">
                                            <Border Classes="row-divider" Margin="0,0,0,4" />
                                            <ItemsControl ItemsSource="{Binding ResetCredits}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:QuotaResetCreditViewModel">
                                                        <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource FgBrush}" />
                                                                <TextBlock Text="{Binding ExpiresLabel}" Classes="row-desc" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Classes="app" VerticalAlignment="Center" Margin="10,0,0,0"
                                                                    Content="{l:Loc QuotaView_Reset_Button}"
                                                                    IsEnabled="{Binding CanRedeem}"
                                                                    Click="OnRedeemResetCredit"
                                                                    Tag="{Binding}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="0" IsVisible="{Binding IsQuotaUsageSelected}">
            <Grid Margin="0,0,0,16" ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="page-title" Text="{l:Loc QuotaView_NineRouterUsage_Title}" />
                    <TextBlock Classes="page-sub" Text="{l:Loc QuotaView_NineRouterUsage_Subtitle}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="icon"
                        ToolTip.Tip="{l:Loc QuotaView_NineRouterUsage_RefreshAllTooltip}"
                        VerticalAlignment="Bottom"
                        IsEnabled="{Binding IsNineRouterEngineRunning}"
                        Click="OnRefreshAllNineRouterUsage">
                    <lucide:PackIconLucide Kind="RefreshCw"
                                           Width="14"
                                           Height="14"
                                           Classes.spin="{Binding IsRefreshingNineRouterUsage}" />
                </Button>
            </Grid>

            <Border Background="#18F59E0B" BorderBrush="#44F59E0B" BorderThickness="1" CornerRadius="8" Padding="10"
                    IsVisible="{Binding IsNineRouterEngineRunning, Converter={StaticResource InvertBool}}">
                <StackPanel Spacing="4">
                    <TextBlock Classes="row-label" Text="{l:Loc Fallback_AddModelPopup_ServerWarning_Title}" />
                    <TextBlock Classes="row-desc" TextWrapping="Wrap"
                               Text="{l:Loc QuotaView_NineRouterUsage_EngineNotRunning}" />
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="22"
                    IsVisible="{Binding ShowNineRouterUsageEmptyState}">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <lucide:PackIconLucide Kind="UserRoundX"
                                           Width="30"
                                           Height="30"
                                           Foreground="{DynamicResource FgFaintBrush}"
                                           HorizontalAlignment="Center" />
                    <TextBlock Classes="row-label" Text="{l:Loc QuotaView_NoAccounts_Title}" HorizontalAlignment="Center" />
                    <TextBlock Classes="row-desc"
                               Text="{l:Loc QuotaView_NineRouterUsage_NoAccountsDescription}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="420" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding NineRouterConnections}"
                          IsVisible="{Binding HasNineRouterUsageConnections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NineRouterConnectionViewModel">
                        <Border Classes="card" Padding="16" Margin="0,0,0,14">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource FgBrush}" />
                                            <Border Classes="chip"
                                                    Background="{DynamicResource AccentSoftBrush}"
                                                    IsVisible="{Binding PlanBadge, Converter={StaticResource StringNotEmpty}}">
                                                <TextBlock Text="{Binding PlanBadge}"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ProviderId}"
                                                   FontFamily="Cascadia Mono,Consolas,monospace"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource FgMutedBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Classes="icon"
                                            ToolTip.Tip="{l:Loc QuotaView_NineRouterUsage_RefreshTooltip}"
                                            Click="OnRefreshNineRouterUsage"
                                            Tag="{Binding}">
                                        <lucide:PackIconLucide Kind="RefreshCw"
                                                               Width="14"
                                                               Height="14"
                                                               Classes.spin="{Binding IsUsageRefreshing}" />
                                    </Button>
                                </Grid>

                                <TextBlock Text="{Binding UsageError}"
                                           Classes="row-desc"
                                           Foreground="{DynamicResource ErrBrush}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding UsageError, Converter={StaticResource StringNotEmpty}}" />

                                <StackPanel Spacing="10" IsVisible="{Binding HasUsage}">
                                    <TextBlock Classes="section-label" Text="{l:Loc QuotaView_Account_UsageSection}" Margin="0" />
                                    <ItemsControl ItemsSource="{Binding UsageBars}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:QuotaBarViewModel">
                                                <StackPanel Spacing="5" Margin="0,0,0,10">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding Title}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource FgBrush}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding UsedLabel}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </Grid>
                                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Used}" Height="9" />
                                                    <TextBlock Text="{Binding ResetIn}" FontSize="10.5"
                                                               Foreground="{DynamicResource FgFaintBrush}"
                                                               IsVisible="{Binding ResetIn, Converter={StaticResource StringNotEmpty}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Border Background="#08FFFFFF" CornerRadius="8" Padding="14"
                                        IsVisible="{Binding HasUsage, Converter={StaticResource InvertBool}}">
                                    <TextBlock Classes="row-desc" Text="{Binding UsageEmptyDescription}" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
